{
  "name": "gladys-elevenlabs",
  "version": "1.1.0",
  "private": true,
  "description": "ElevenLabs external integration for Gladys Assistant: the voice of Gladys announcements, synthesized by ElevenLabs.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "smoke": "node --env-file=.env scripts/smoke.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test test/*.test.js",
    "coverage": "node --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-branches=85 --test-coverage-functions=85 test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@gladysassistant/integration-sdk": "^0.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.10"
  }
}
